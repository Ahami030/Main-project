// ER diagram for Main-project (MongoDB) — paste into https://dbdiagram.io
// Generated from the Mongoose models in app/models and models/.
// MongoDB has no foreign keys: every Ref below is a reference the app code follows.
// Embedded sub-documents (arrays/objects inside a document) are shown as json columns.

Project MainProject {
  database_type: 'MongoDB'
  Note: 'RFQ → Quotation → PO → Billing → Payment proof workflow'
}

// ───────────────────────── Users ─────────────────────────

Table users {
  _id objectId [pk]
  name varchar
  email varchar [unique, not null]
  password varchar [not null, note: 'hashed']
  role varchar [note: 'user | employee | admin']
  permissions json [note: 'string[] e.g. quotation, po']
  organizationName varchar
  taxId varchar
  phone varchar
  lineId varchar
  billingAddress varchar
  shippingAddress varchar
  createdAt datetime
  updatedAt datetime
}

Table walkin_credentials {
  _id objectId [pk]
  userId varchar [unique, not null]
  password varchar [note: 'encrypted, shown once to staff']
  createdAt datetime
  updatedAt datetime
}

// ───────────────────────── Quotation flow ─────────────────────────

Table quotations {
  _id objectId [pk]
  userId varchar [not null]
  filename varchar [not null]
  pdfId varchar
  pdfPath varchar [note: 'Vercel Blob URL']
  rfqNumber varchar [note: 'links to Test_insert.rfq_number (one job)']
  status varchar [note: 'processing | sent | reviewing | completed | bargaining | confirmed | failed']
  failReason varchar [note: 'set when n8n fails or times out (10 min)']
  dueAt datetime [note: 'customer: "want the quotation by"']
  "handledBy.id" varchar [note: 'staff who first sent it to the customer']
  "handledBy.name" varchar
  handledAt datetime
  createdAt datetime
  updatedAt datetime
}

Table Test_insert {
  _id objectId [pk]
  rfq_number varchar [note: 'generated by the web, copied by n8n']
  USER_ID varchar
  folderId varchar
  document_type varchar
  rfq_date varchar
  due_date varchar
  buyer_company_name varchar
  vendor_company_name varchar
  line_items json [note: '[{ item_number, description, quantity, unit, unit_price }]']
  terms_and_conditions json [note: '{ delivery_location, delivery_time, payment_terms }']
  version int
  change_log json [note: '[{ index, is_new, changed_fields[] }]']
  editors json [note: '[{ id, name, at }] staff on the edit page (presence, 60s TTL)']
  createdAt datetime
  updatedAt datetime

  Note: 'RFQ collection (name left over from testing). Inserted by n8n (OCR + Gemini).'
}

Table pdfs {
  _id objectId [pk]
  userId varchar [not null]
  filename varchar
  path varchar
  uploadDate datetime
}

Table rfq_folders {
  _id objectId [pk]
  name varchar [not null]
  parentId varchar [note: 'null = root']
  createdAt datetime
  updatedAt datetime
}

Table chats {
  _id objectId [pk]
  userId objectId [not null, note: 'ObjectId here, string everywhere else']
  senderRole varchar [note: 'user | admin']
  message varchar
  fileUrl varchar
  fileType varchar
  fileName varchar
  isEdited boolean
  editedAt datetime
  isDeleted boolean
  createdAt datetime
  updatedAt datetime
}

// ───────────────────────── Purchase / billing / payment ─────────────────────────

Table purchaseorders {
  _id objectId [pk]
  poNumber varchar [unique]
  userId varchar [not null]
  userName varchar
  userEmail varchar
  status varchar [note: 'pending | accepted | billed']
  filePath varchar
  fileOrigName varchar
  fileMimeType varchar
  taxInvoices json [note: '[{ invoiceNumber, invoiceDate, amount }]']
  billedAt datetime
  billingId objectId
  createdAt datetime
  updatedAt datetime
}

Table billings {
  _id objectId [pk]
  billingNumber varchar [unique]
  customerId varchar [not null]
  customerName varchar
  customerEmail varchar
  poIds json [note: 'ObjectId[] of purchaseorders']
  poNumbers json
  taxInvoices json
  status varchar [note: 'draft | finalized']
  billingDate datetime
  paymentStatus varchar [note: 'unpaid | partial | paid']
  expiresAt datetime
  fullResetOnExpiry boolean
  createdAt datetime
  updatedAt datetime
}

Table paymentproofs {
  _id objectId [pk]
  proofNumber varchar [unique]
  billingId objectId
  billingNumber varchar
  poId objectId
  poIds json
  poNumbers json
  customerId varchar [not null]
  customerName varchar
  customerEmail varchar
  amount decimal
  paymentDate varchar
  paymentMethod varchar [note: 'bank_transfer | cash | cheque']
  bankName varchar
  accountName varchar
  referenceNumber varchar
  note varchar
  filePath varchar
  fileOrigName varchar
  fileMimeType varchar
  status varchar [note: 'pending | approved | rejected']
  installmentNumber int
  reviewedBy varchar
  reviewedAt datetime
  rejectionReason varchar
  history json [note: '[{ action, actor, actorName, timestamp, note, amount }]']
  createdAt datetime
  updatedAt datetime
}

// ───────────────────────── Archive ─────────────────────────

Table archived_rfqs {
  _id objectId [pk]
  originalQuotationId varchar
  USER_ID varchar
  rfq_number varchar
  document_type varchar
  rfq_date varchar
  due_date varchar
  buyer_company_name varchar
  vendor_company_name varchar
  line_items json
  terms_and_conditions json
  version int
  archivedAt datetime
}

Table archived_chats {
  _id objectId [pk]
  userId varchar
  originalQuotationId varchar
  messages json [note: '[{ senderRole, message, originalCreatedAt }]']
  archivedAt datetime
}

Table archivedbillings {
  _id objectId [pk]
  originalBillingId varchar [not null]
  billingNumber varchar
  customerId varchar
  customerName varchar
  customerEmail varchar
  poIds json
  poNumbers json
  taxInvoices json
  billingStatus varchar
  billingDate datetime
  expiresAt datetime
  originalCreatedAt datetime
  archiveReason varchar [note: 'manual_reset | expired | full_reset']
  archivedAt datetime
}

// ───────────────────────── Other ─────────────────────────

Table checklistitems {
  _id objectId [pk]
  itemId varchar [unique, not null]
  checked boolean
  note varchar
}

// ───────────────────────── Relationships ─────────────────────────
// > many-to-one   - one-to-one

// quotation flow
Ref: quotations.userId > users._id
Ref: quotations.rfqNumber - Test_insert.rfq_number   // one job = one RFQ (key added for multi-job)
Ref: quotations.pdfId - pdfs._id
Ref: quotations."handledBy.id" > users._id            // staff work stats
Ref: Test_insert.USER_ID > users._id
Ref: Test_insert.folderId > rfq_folders._id
Ref: rfq_folders.parentId > rfq_folders._id           // nested folders
Ref: pdfs.userId > users._id
Ref: chats.userId > users._id                         // one chat thread per customer
Ref: walkin_credentials.userId - users._id

// purchase / billing / payment
Ref: purchaseorders.userId > users._id
Ref: purchaseorders.billingId > billings._id
Ref: billings.customerId > users._id
Ref: paymentproofs.billingId > billings._id
Ref: paymentproofs.poId > purchaseorders._id
Ref: paymentproofs.customerId > users._id

// archive (logical: the original is deleted after archiving)
Ref: archived_rfqs.originalQuotationId > quotations._id
Ref: archived_chats.originalQuotationId > quotations._id
Ref: archived_chats.userId > users._id
Ref: archivedbillings.originalBillingId > billings._id

// ───────────────────────── Groups (colored boxes) ─────────────────────────

TableGroup "Quotation flow" {
  quotations
  Test_insert
  pdfs
  rfq_folders
  chats
}

TableGroup "Purchase & billing" {
  purchaseorders
  billings
  paymentproofs
}

TableGroup "Archive" {
  archived_rfqs
  archived_chats
  archivedbillings
}

TableGroup "Users" {
  users
  walkin_credentials
}
